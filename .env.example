# Copy to .env (gitignored) and fill in. Never commit real values.

# IBKR Gateway connection
IBKR_HOST=127.0.0.1
IBKR_PORT=4004          # in the compose stack the app reaches Gateway via socat: paper=4004, live=4003.
                        # (Gateway's raw API is 4002/4001 but binds localhost-only w/ TrustedIPs=127.0.0.1.)
IBKR_CLIENT_ID=1
IBKR_TRADING_MODE=paper # paper | live

# Storage (Phase 1: DuckDB + partitioned Parquet on the VPS disk)
DATA_DIR=./data                       # Parquet partitions + DuckDB file live here
DUCKDB_PATH=./data/small_cap_stack.duckdb

# Fundamentals — float source (#109). Free key from financialmodelingprep.com (250 req/day, US
# stocks). Unset → yfinance-only. Quote the value; no spaces/inline comments on this line.
FMP_API_KEY=

# Monitoring
HEALTHCHECKS_PING_URL=
METRICS_PORT=9090

# --- Deployment only (docker-compose / IB Gateway container) ---
# App image tag compose resolves (#278). The deploy workflow WRITES this on the VPS, pinning the
# deployed commit's `sha-<short>` so a reboot brings back that same image. Leave blank locally —
# compose falls back to :latest. Not a secret.
IMAGE_TAG=
# IBKR login for the gnzsnz/ib-gateway container. SET ON THE VPS ONLY — never commit.
TWS_USERID=
TWS_PASSWORD=
READ_ONLY_API=no            # Phase 1 is read-only anyway (no orders); keep 'no' for data/whatIf
AUTO_RESTART_TIME=23:45 PM  # IBC daily Gateway restart (outside the scan window)
# If the username is already logged in elsewhere: manual (block), primary (take over,
# kicks the other session), secondary (yield). Use a dedicated automation username to avoid this.
EXISTING_SESSION_DETECTED_ACTION=manual
TZ=America/New_York
JSON_LOGS=true              # structured JSON logs in production

# --- Overnight pre-market harvest (#431). VPS only; see deploy/RUNBOOK.md §13. ---
# Vendor key for the historical minute bars (Massive, ex-Polygon). #430 chose the FREE tier, so the
# harvest is priced by a 5 calls/min limit rather than by lookback. Never put this in a cloud
# session — it has no secret store (env vars are plaintext).
# On the box you do NOT set this by hand: add it as a repository Actions secret and run the
# `harvest` workflow with `command: install-key`, which writes it here from the box's own runner
# (RUNBOOK §13). That is the whole setup path, and it works from a phone.
MASSIVE_API_KEY=
# Harvest-only knobs (all optional; defaults in config.py). The volume floor sets the ~217
# candidates/day that price the harvest at ~45 nights — measure with `harvest sweep` before moving
# it (RUNBOOK §13.1). Turning off minute bars saves ~36M rows of disk at the cost of a full
# re-fetch if the reconstruction rules ever change.
HARVEST_MIN_DAY_VOLUME=100000
HARVEST_STORE_MINUTE_BARS=true
# How far back to ASK for. The vendor decides how far back you actually get: since #440 a refusal
# is recorded as an entitlement floor on the checkpoint and the plan trims itself, so setting this
# past the plan you bought costs one refused call, not the night. Leave it at the default (730)
# unless you have a reason — `harvest status` reports the discovered floor next to it.
# HARVEST_LOOKBACK_DAYS=730
