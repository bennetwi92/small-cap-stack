# Copy to /etc/alloy/scs.env on the box, fill in, `chmod 600`. NEVER commit real values.
#
# Alloy reads these via `sys.env(...)` in deploy/alloy/config.alloy. They come from the Grafana
# Cloud stack's "Prometheus" / "Send Metrics" panel — the URL ends in /api/prom/push, the username
# is a numeric instance id, and the key is an access policy token with the `metrics:write` scope.
#
# Scope the token to metrics:write and nothing else. It lives in plaintext on a box that runs a
# trading system; a token that can also read or administer the stack is a strictly worse thing to
# leave lying there for no additional capability.

GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-eu-west-N.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_KEY=
