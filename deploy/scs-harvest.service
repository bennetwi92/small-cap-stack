[Unit]
Description=small-cap-stack overnight pre-market harvest (#431)
Documentation=https://github.com/bennetwi92/small-cap-stack/blob/main/deploy/RUNBOOK.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/small-cap-stack
# The container carries the real memory cap (--memory=1g, no swap — see scripts/harvest.sh); these
# are the belt to its braces, and they bound the wrapper too.
MemoryMax=1200M
MemorySwapMax=0
# The tracker's latency matters and this job's does not. Both halves are needed: CPU weight alone
# still lets a background job monopolise the disk queue on a 2 vCPU box.
Nice=19
IOSchedulingClass=idle
CPUWeight=20
# The job checkpoints after every completed session, so a kill is at worst one session of lost API
# budget. Give it a moment to finish the parquet write it may be inside.
TimeoutStopSec=120
KillSignal=SIGTERM
ExecStart=/opt/small-cap-stack/scripts/harvest.sh run
# Deliberately no Restart=: a failed night is not an emergency (the next one resumes from the
# checkpoint), and a restart loop against a rate-limited vendor is how the API key gets blocked.

[Install]
WantedBy=multi-user.target
